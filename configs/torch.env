# PyTorch CPU runtime tuning parameters

OMP_NUM_THREADS=16
OMP_PROC_BIND=spread
OMP_PLACES=threads
OMP_DYNAMIC=FALSE

MKL_NUM_THREADS=16
MKL_DYNAMIC=FALSE

KMP_AFFINITY=granularity=fine,compact,1,0
KMP_BLOCKTIME=0

# Avoid thread contention with MKL BLAS
OPENBLAS_NUM_THREADS=1

# PyTorch allocator
PYTORCH_ALLOC_CONF=expandable_segments:True
