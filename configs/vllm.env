# vLLM CPU serving runtime configuration

LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4:/workspace/.venv/lib/libiomp5.so
VLLM_TARGET_DEVICE=cpu

VLLM_CPU_KVCACHE_SPACE=4
VLLM_CPU_OMP_THREADS_BIND=0

# CPU attention backend (default: TORCH_SDPA)
# VLLM_ATTENTION_BACKEND=TORCH_SDPA

# Ray distributed execution (set to 1 for single-node)
# VLLM_WORKER_MULTIPROC_METHOD=spawn
